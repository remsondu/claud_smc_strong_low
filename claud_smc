//===================== UTILITY: BAR ACCESS ==========================
// Logical offset 0 = most recent CLOSED bar (shift 1 in MQL5).
// During backfill, g_scanShift > 0 walks the "current closed bar" backward
// through history so the same pivot/structure code can replay over old bars.
double H(int off)         { return iHigh (_Symbol, _Period, off + 1 + g_scanShift); }
double L(int off)         { return iLow  (_Symbol, _Period, off + 1 + g_scanShift); }
double C_(int off)        { return iClose(_Symbol, _Period, off + 1 + g_scanShift); }
double O_(int off)        { return iOpen (_Symbol, _Period, off + 1 + g_scanShift); }
datetime T(int off)       { return iTime (_Symbol, _Period, off + 1 + g_scanShift); }

double Highest(int size) {
    int idx = iHighest(_Symbol, _Period, MODE_HIGH, size, 1 + g_scanShift);
    if(idx < 0) return -DBL_MAX;
    return iHigh(_Symbol, _Period, idx);
}
double Lowest(int size) {
    int idx = iLowest(_Symbol, _Period, MODE_LOW, size, 1 + g_scanShift);
    if(idx < 0) return DBL_MAX;
    return iLow(_Symbol, _Period, idx);
}

double GetATR(int off) {
    if(g_atrHandle == INVALID_HANDLE) return 0;
    double buf[];
    if(CopyBuffer(g_atrHandle, 0, off + 1 + g_scanShift, 1, buf) < 1) return 0;
    return buf[0];
}
double GetATR14(int off) {
    if(g_atr14Handle == INVALID_HANDLE) return 0;
    double buf[];
    if(CopyBuffer(g_atr14Handle, 0, off + 1 + g_scanShift, 1, buf) < 1) return 0;
    return buf[0];
}
double GetVolatility(int off) {
    if(InpOBFilter == SMC_ATR) return GetATR(off);
    return g_processedBars > 0 ? g_cumTR / g_processedBars : 0;
}

double GetParsedHigh(int off) {
    double v = GetVolatility(off);
    double h = H(off), l = L(off);
    return (h - l) >= 2.0 * v ? l : h;
}
double GetParsedLow(int off) {
    double v = GetVolatility(off);
    double h = H(off), l = L(off);
    return (h - l) >= 2.0 * v ? h : l;
}

void UpdateCumTR() {
    double tr = MathMax(H(0), C_(1)) - MathMin(L(0), C_(1));
    g_cumTR += tr;
    g_processedBars++;
}

bool IsNewBar() {
    datetime t = iTime(_Symbol, _Period, 0);
    if(t == 0) return false;
    if(t != g_lastBarTime) {
        g_lastBarTime = t;
        return true;
    }
    return false;
}

//===================== UTILITY: OBJECT DRAWING ======================
void DrawHline(string name, double price, color c, ENUM_LINE_STYLE st = STYLE_SOLID, int width = 1) {
    if(ObjectFind(0, name) < 0) ObjectCreate(0, name, OBJ_HLINE, 0, 0, price);
    ObjectSetDouble (0, name, OBJPROP_PRICE,  price);
    ObjectSetInteger(0, name, OBJPROP_COLOR,  c);
    ObjectSetInteger(0, name, OBJPROP_STYLE,  st);
    ObjectSetInteger(0, name, OBJPROP_WIDTH,  width);
    ObjectSetInteger(0, name, OBJPROP_BACK,   true);
    ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
}

void DrawTrend(string name, datetime t1, double p1, datetime t2, double p2,
               color c, ENUM_LINE_STYLE st = STYLE_SOLID, int width = 1, bool ray = false) {
    if(ObjectFind(0, name) < 0)
        ObjectCreate(0, name, OBJ_TREND, 0, t1, p1, t2, p2);
    ObjectMove(0, name, 0, t1, p1);
    ObjectMove(0, name, 1, t2, p2);
    ObjectSetInteger(0, name, OBJPROP_COLOR,         c);
    ObjectSetInteger(0, name, OBJPROP_STYLE,         st);
    ObjectSetInteger(0, name, OBJPROP_WIDTH,         width);
    ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT,     ray);
    ObjectSetInteger(0, name, OBJPROP_RAY_LEFT,      false);
    ObjectSetInteger(0, name, OBJPROP_BACK,          false);
    ObjectSetInteger(0, name, OBJPROP_SELECTABLE,    false);
    ObjectSetInteger(0, name, OBJPROP_HIDDEN,        true);
}

// NOTE (v1.11 fix): OBJ_RECTANGLE in MT5 uses OBJPROP_COLOR for both outline AND fill
// when OBJPROP_FILL=true. OBJPROP_BGCOLOR is silently ignored on OBJ_RECTANGLE — it
// only applies to OBJ_RECTANGLE_LABEL / OBJ_EDIT / OBJ_BUTTON. So if a caller passes
// border=CLR_NONE (intending a borderless filled box), the whole rectangle disappears.
// We coerce border→fill in that case so the box always renders.
void DrawRect(string name, datetime t1, double p1, datetime t2, double p2,
              color border, color fill, bool back = true) {
    if(ObjectFind(0, name) < 0)
        ObjectCreate(0, name, OBJ_RECTANGLE, 0, t1, p1, t2, p2);
    ObjectMove(0, name, 0, t1, p1);
    ObjectMove(0, name, 1, t2, p2);
    color drawColor = (border == CLR_NONE) ? fill : border;
    ObjectSetInteger(0, name, OBJPROP_COLOR,      drawColor);
    ObjectSetInteger(0, name, OBJPROP_BGCOLOR,    fill);   // kept for API symmetry; ignored by OBJ_RECTANGLE
    ObjectSetInteger(0, name, OBJPROP_FILL,       true);
    ObjectSetInteger(0, name, OBJPROP_BACK,       back);
    ObjectSetInteger(0, name, OBJPROP_STYLE,      STYLE_SOLID);
    ObjectSetInteger(0, name, OBJPROP_WIDTH,      1);
    ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
    ObjectSetInteger(0, name, OBJPROP_HIDDEN,     true);
}

void DrawText(string name, datetime t, double p, string txt, color c, int fontSize = 8,
              ENUM_ANCHOR_POINT anchor = ANCHOR_CENTER) {
    if(ObjectFind(0, name) < 0)
        ObjectCreate(0, name, OBJ_TEXT, 0, t, p);
    ObjectMove(0, name, 0, t, p);
    ObjectSetString (0, name, OBJPROP_TEXT,    txt);
    ObjectSetInteger(0, name, OBJPROP_COLOR,   c);
    ObjectSetInteger(0, name, OBJPROP_FONTSIZE, fontSize);
    ObjectSetString (0, name, OBJPROP_FONT,    "Arial");
    ObjectSetInteger(0, name, OBJPROP_ANCHOR,  anchor);
    ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
    ObjectSetInteger(0, name, OBJPROP_HIDDEN,  true);
}

void SafeDelete(string name) {
    if(ObjectFind(0, name) >= 0) ObjectDelete(0, name);
}

void DeleteByPrefix(string prefix) {
    int total = ObjectsTotal(0, -1, -1);
    for(int i = total - 1; i >= 0; i--) {
        string n = ObjectName(0, i, -1, -1);
        if(StringFind(n, prefix) == 0) ObjectDelete(0, n);
    }
}

//===================== PIVOT INIT ===================================
void InitPivot(Pivot &p) {
    p.currentLevel = 0.0;
    p.lastLevel    = 0.0;
    p.crossed      = false;
    p.barTime      = 0;
    p.barShift     = 0;
}

//===================== LEG DETECTION ================================
int LegFunc(int size, int &prevLegOut, int &currentLegInOut) {
    double pivotHigh = H(size);
    double pivotLow  = L(size);
    double recentHi  = Highest(size);
    double recentLo  = Lowest(size);

    prevLegOut = currentLegInOut;
    if(pivotHigh > recentHi)      currentLegInOut = BEARISH_LEG;
    else if(pivotLow < recentLo)  currentLegInOut = BULLISH_LEG;
    return currentLegInOut;
}

//===================== STRUCTURE / PIVOT CAPTURE ====================
// Draws an "HH/HL/LH/LL" tag at a confirmed swing point.
// Convention: below=true → label appears BELOW the price (anchor at text's UPPER edge).
void DrawSwingPointLabel(datetime t, double price, string tag, color c, bool below) {
    string name = MakeName("swp");
    DrawText(name, t, price, tag, c, LabelFontSize(InpSwingLabelSize),
             below ? ANCHOR_UPPER : ANCHOR_LOWER);
}

// Draw an EQH / EQL line + label connecting two equal pivots
void DrawEqualHighLow(Pivot &p, double level, int size, bool isHigh) {
    color c = isHigh ? ResolveSwingBear() : ResolveSwingBull();
    string tag = isHigh ? "EQH" : "EQL";

    if(InpMode == SMC_PRESENT) {
        long lastObj = isHigh ? g_lastEqualHighObj : g_lastEqualLowObj;
        SafeDelete(OBJ_PREFIX + "eqline_" + IntegerToString(lastObj));
        SafeDelete(OBJ_PREFIX + "eqtxt_"  + IntegerToString(lastObj));
    }

    g_objCounter++;
    long id = g_objCounter;
    if(isHigh) g_lastEqualHighObj = id;
    else       g_lastEqualLowObj  = id;

    string lineName = OBJ_PREFIX + "eqline_" + IntegerToString(id);
    string textName = OBJ_PREFIX + "eqtxt_"  + IntegerToString(id);

    DrawTrend(lineName, p.barTime, p.currentLevel, T(size), level, c, STYLE_DOT, 1, false);

    // Place label centered between the two equal points
    datetime midT = (datetime)((long)p.barTime / 2 + (long)T(size) / 2);
    DrawText(textName, midT, level, tag, c, LabelFontSize(InpEQHEQLSize),
             isHigh ? ANCHOR_LOWER : ANCHOR_UPPER);
}

// Capture current structure: detect pivots at given size, optionally for "equal" / "internal" channels.
void GetCurrentStructure(int size, bool equalMode, bool internalMode) {
    int prevLeg = 0, curLeg = 0;
    if(equalMode)         { curLeg = g_equalLeg;    prevLeg = g_equalLegPrev;   }
    else if(internalMode) { curLeg = g_internalLeg; prevLeg = g_internalLegPrev;}
    else                  { curLeg = g_swingLeg;    prevLeg = g_swingLegPrev;   }

    LegFunc(size, prevLeg, curLeg);

    if(equalMode)         { g_equalLeg    = curLeg; g_equalLegPrev    = prevLeg; }
    else if(internalMode) { g_internalLeg = curLeg; g_internalLegPrev = prevLeg; }
    else                  { g_swingLeg    = curLeg; g_swingLegPrev    = prevLeg; }

    bool newPivot     = (curLeg != prevLeg);
    if(!newPivot) return;

    bool pivotLow     = (curLeg == BULLISH_LEG);
    bool pivotHigh    = (curLeg == BEARISH_LEG);

    double atr = GetATR(size);

    if(pivotLow) {
        // pick the right pivot to update
        if(equalMode) {
            if(MathAbs(g_equalLow.currentLevel - L(size)) < InpEQHEQLThresh * atr && g_equalLow.currentLevel != 0.0) {
                DrawEqualHighLow(g_equalLow, L(size), size, false);
                g_alerts.equalLows = true;
            }
            g_equalLow.lastLevel    = g_equalLow.currentLevel;
            g_equalLow.currentLevel = L(size);
            g_equalLow.crossed      = false;
            g_equalLow.barTime      = T(size);
            g_equalLow.barShift     = size;
        }
        else if(internalMode) {
            g_internalLow.lastLevel    = g_internalLow.currentLevel;
            g_internalLow.currentLevel = L(size);
            g_internalLow.crossed      = false;
            g_internalLow.barTime      = T(size);
            g_internalLow.barShift     = size;
        }
        else {
            g_swingLow.lastLevel    = g_swingLow.currentLevel;
            g_swingLow.currentLevel = L(size);
            g_swingLow.crossed      = false;
            g_swingLow.barTime      = T(size);
            g_swingLow.barShift     = size;

            g_trailing.bottom         = g_swingLow.currentLevel;
            g_trailing.barTime        = g_swingLow.barTime;
            g_trailing.lastBottomTime = g_swingLow.barTime;

            if(InpShowSwingPoints) {
                string tag = g_swingLow.currentLevel < g_swingLow.lastLevel ? "LL" : "HL";
                // v1.11 fix: label drawn BELOW the swing low (below=true → ANCHOR_UPPER).
                DrawSwingPointLabel(T(size), L(size), tag, ResolveSwingBull(), true);
            }
        }
    }
    else if(pivotHigh) {
        if(equalMode) {
            if(MathAbs(g_equalHigh.currentLevel - H(size)) < InpEQHEQLThresh * atr && g_equalHigh.currentLevel != 0.0) {
                DrawEqualHighLow(g_equalHigh, H(size), size, true);
                g_alerts.equalHighs = true;
            }
            g_equalHigh.lastLevel    = g_equalHigh.currentLevel;
            g_equalHigh.currentLevel = H(size);
            g_equalHigh.crossed      = false;
            g_equalHigh.barTime      = T(size);
            g_equalHigh.barShift     = size;
        }
        else if(internalMode) {
            g_internalHigh.lastLevel    = g_internalHigh.currentLevel;
            g_internalHigh.currentLevel = H(size);
            g_internalHigh.crossed      = false;
            g_internalHigh.barTime      = T(size);
            g_internalHigh.barShift     = size;
        }
        else {
            g_swingHigh.lastLevel    = g_swingHigh.currentLevel;
            g_swingHigh.currentLevel = H(size);
            g_swingHigh.crossed      = false;
            g_swingHigh.barTime      = T(size);
            g_swingHigh.barShift     = size;

            g_trailing.top         = g_swingHigh.currentLevel;
            g_trailing.barTime     = g_swingHigh.barTime;
            g_trailing.lastTopTime = g_swingHigh.barTime;

            if(InpShowSwingPoints) {
                string tag = g_swingHigh.currentLevel > g_swingHigh.lastLevel ? "HH" : "LH";
                // v1.11 fix: label drawn ABOVE the swing high (below=false → ANCHOR_LOWER).
                DrawSwingPointLabel(T(size), H(size), tag, ResolveSwingBear(), false);
            }
        }
    }
}

//===================== STRUCTURE DRAW ===============================
// Render a BOS/CHoCH line + tag at center
void DrawStructure(Pivot &p, string tag, color c, ENUM_LINE_STYLE st,
                   ENUM_SMC_LABEL_SIZE sz, bool labelBelow,
                   bool internalChannel, bool isLow) {
    if(InpMode == SMC_PRESENT) {
        long lastObj = 0;
        if(internalChannel) lastObj = isLow ? g_lastInternalLowStructObj : g_lastInternalHighStructObj;
        else                lastObj = isLow ? g_lastSwingLowStructObj    : g_lastSwingHighStructObj;
        SafeDelete(OBJ_PREFIX + "structL_" + IntegerToString(lastObj));
        SafeDelete(OBJ_PREFIX + "structT_" + IntegerToString(lastObj));
    }

    g_objCounter++;
    long id = g_objCounter;
    if(internalChannel) {
        if(isLow) g_lastInternalLowStructObj = id;
        else      g_lastInternalHighStructObj = id;
    } else {
        if(isLow) g_lastSwingLowStructObj = id;
        else      g_lastSwingHighStructObj = id;
    }

    string lname = OBJ_PREFIX + "structL_" + IntegerToString(id);
    string tname = OBJ_PREFIX + "structT_" + IntegerToString(id);

    datetime nowT = T(0);
    DrawTrend(lname, p.barTime, p.currentLevel, nowT, p.currentLevel, c, st, 1, false);

    datetime midT = (datetime)((long)p.barTime / 2 + (long)nowT / 2);
    DrawText(tname, midT, p.currentLevel, tag, c, LabelFontSize(sz),
             labelBelow ? ANCHOR_UPPER : ANCHOR_LOWER);
}

//===================== ORDER BLOCKS =================================
void PushOB(OrderBlockRec &arr[], OrderBlockRec &ob) {
    int n = ArraySize(arr);
    ArrayResize(arr, n + 1);
    // shift right (unshift)
    for(int i = n; i > 0; i--) arr[i] = arr[i - 1];
    arr[0] = ob;
    if(ArraySize(arr) > 100) ArrayResize(arr, 100);
}

void StoreOrderBlock(Pivot &p, bool internalChannel, int bias) {
    if(!internalChannel && !InpShowSwingOBs) return;
    if(internalChannel  && !InpShowInternalOBs) return;

    // Find OB candle between pivot bar and current closed bar.
    // pivotOff is expressed in logical offsets relative to the CURRENT scan position,
    // so it needs g_scanShift subtracted out (during live mode g_scanShift==0).
    int pivotShiftMQL = iBarShift(_Symbol, _Period, p.barTime, false);
    if(pivotShiftMQL <= 0) return;
    int pivotOff = pivotShiftMQL - 1 - g_scanShift;
    if(pivotOff < 1) return;

    int extremeOff = pivotOff;
    double extremeVal = (bias == BEARISH) ? -DBL_MAX : DBL_MAX;

    for(int off = pivotOff; off >= 1; off--) {
        if(bias == BEARISH) {
            double ph = GetParsedHigh(off);
            if(ph > extremeVal) { extremeVal = ph; extremeOff = off; }
        } else {
            double pl = GetParsedLow(off);
            if(pl < extremeVal) { extremeVal = pl; extremeOff = off; }
        }
    }

    OrderBlockRec ob;
    ob.obHigh = GetParsedHigh(extremeOff);
    ob.obLow  = GetParsedLow(extremeOff);
    ob.obTime = T(extremeOff);
    ob.bias   = bias;
    g_objCounter++;
    ob.objId  = g_objCounter;
    ob.active = true;

    if(internalChannel) PushOB(g_internalOBs, ob);
    else                PushOB(g_swingOBs,    ob);
}

void RemoveOBAt(OrderBlockRec &arr[], int idx) {
    int n = ArraySize(arr);
    if(idx < 0 || idx >= n) return;
    // delete drawn object
    SafeDelete(OBJ_PREFIX + "ob_" + IntegerToString(arr[idx].objId));
    for(int i = idx; i < n - 1; i++) arr[i] = arr[i + 1];
    ArrayResize(arr, n - 1);
}

void DeleteOrderBlocks(bool internalChannel) {
    int n = internalChannel ? ArraySize(g_internalOBs) : ArraySize(g_swingOBs);

    double bullSrc = (InpOBMitigation == SMC_BY_CLOSE) ? C_(0) : L(0);
    double bearSrc = (InpOBMitigation == SMC_BY_CLOSE) ? C_(0) : H(0);

    for(int i = n - 1; i >= 0; i--) {
        OrderBlockRec ob;
        if(internalChannel) ob = g_internalOBs[i];
        else                ob = g_swingOBs[i];

        bool crossed = false;
        if(ob.bias == BEARISH && bearSrc > ob.obHigh) {
            crossed = true;
            if(internalChannel) g_alerts.internalBearishOB = true;
            else                g_alerts.swingBearishOB    = true;
        } else if(ob.bias == BULLISH && bullSrc < ob.obLow) {
            crossed = true;
            if(internalChannel) g_alerts.internalBullishOB = true;
            else                g_alerts.swingBullishOB    = true;
        }
        if(crossed) {
            if(internalChannel) RemoveOBAt(g_internalOBs, i);
            else                RemoveOBAt(g_swingOBs, i);
        }
    }
}

void DrawOrderBlocks(bool internalChannel) {
    int maxCount = internalChannel ? InpInternalOBCount : InpSwingOBCount;
    if(maxCount <= 0) return;

    int n;
    if(internalChannel) n = ArraySize(g_internalOBs);
    else                n = ArraySize(g_swingOBs);
    int show = MathMin(maxCount, n);
    datetime rightEdge = T(0) + PeriodSeconds(_Period) * 50;

    for(int i = 0; i < show; i++) {
        OrderBlockRec ob;
        if(internalChannel) ob = g_internalOBs[i];
        else                ob = g_swingOBs[i];

        color fill;
        if(InpStyle == SMC_MONOCHROME) {
            fill = (ob.bias == BEARISH) ? C'120,123,134' : C'200,203,212';
        } else {
            if(internalChannel) fill = (ob.bias == BEARISH) ? InpInternalBearOBColor : InpInternalBullOBColor;
            else                fill = (ob.bias == BEARISH) ? InpSwingBearOBColor    : InpSwingBullOBColor;
        }
        // v1.11 fix: OBJ_RECTANGLE has no separate border/fill channels in MT5, so
        // passing CLR_NONE here used to make internal OBs invisible. Always use the
        // fill color — internal OBs now render with a 1-pixel outline of the same hue,
        // which is essentially indistinguishable from a borderless fill at chart zoom.
        color border = fill;

        string name = OBJ_PREFIX + "ob_" + IntegerToString(ob.objId);
        DrawRect(name, ob.obTime, ob.obHigh, rightEdge, ob.obLow, border, fill, true);
    }
}


//===================== DISPLAY STRUCTURE (BOS/CHoCH) ================
void DisplayStructure(bool internalChannel) {
    bool bullishBar = true, bearishBar = true;
    if(InpInternalConfluence && internalChannel) {
        double h = H(0), l = L(0), c = C_(0), o = O_(0);
        bullishBar = (h - MathMax(c, o)) > (MathMin(c, o) - l);
        bearishBar = (h - MathMax(c, o)) < (MathMin(c, o) - l);
    }

    // ===== Bullish side: close crosses ABOVE pivotHigh =====
    Pivot ph; TrendBias tb;
    if(internalChannel) { ph = g_internalHigh; tb = g_internalTrend; }
    else                { ph = g_swingHigh;    tb = g_swingTrend;    }

    bool extraBull = internalChannel
        ? (g_internalHigh.currentLevel != g_swingHigh.currentLevel && bullishBar)
        : true;

    double curC = C_(0), prevC = C_(1);
    if(curC > ph.currentLevel && prevC <= ph.currentLevel && !ph.crossed && extraBull
       && ph.currentLevel != 0.0) {

        string tag = (tb.bias == BEARISH) ? LBL_TAG_CHOCH : LBL_TAG_BOS;

        if(internalChannel) {
            if(tag == LBL_TAG_CHOCH) g_alerts.internalBullishCHoCH = true;
            else                     g_alerts.internalBullishBOS   = true;
        } else {
            if(tag == LBL_TAG_CHOCH) g_alerts.swingBullishCHoCH = true;
            else                     g_alerts.swingBullishBOS   = true;
        }

        if(internalChannel) { g_internalHigh.crossed = true; g_internalTrend.bias = BULLISH; }
        else                { g_swingHigh.crossed    = true; g_swingTrend.bias    = BULLISH; }

        bool show;
        ENUM_SMC_STRUCT_DISPLAY filt;
        if(internalChannel) { show = InpShowInternals;  filt = InpShowInternalBull; }
        else                { show = InpShowStructure;  filt = InpShowSwingBull;    }

        bool passFilter = (filt == SMC_ALL)
                        || (filt == SMC_BOS_ONLY  && tag != LBL_TAG_CHOCH)
                        || (filt == SMC_CHOCH_ONLY && tag == LBL_TAG_CHOCH);

        if(show && passFilter) {
            color c = internalChannel ? ResolveInternalBull() : ResolveSwingBull();
            ENUM_LINE_STYLE st = internalChannel ? STYLE_DASH : STYLE_SOLID;
            ENUM_SMC_LABEL_SIZE sz = internalChannel ? InpInternalLabelSize : InpSwingLabelSize;
            // Pass a fresh local pivot copy by reference
            Pivot phCopy = ph;
            DrawStructure(phCopy, tag, c, st, sz, false, internalChannel, false);
        }

        if((internalChannel && InpShowInternalOBs) || (!internalChannel && InpShowSwingOBs)) {
            Pivot phCopy = ph;
            StoreOrderBlock(phCopy, internalChannel, BULLISH);
        }
    }

    // ===== Bearish side: close crosses BELOW pivotLow =====
    Pivot pl;
    if(internalChannel) { pl = g_internalLow; tb = g_internalTrend; }
    else                { pl = g_swingLow;    tb = g_swingTrend;    }

    bool extraBear = internalChannel
        ? (g_internalLow.currentLevel != g_swingLow.currentLevel && bearishBar)
        : true;

    if(curC < pl.currentLevel && prevC >= pl.currentLevel && !pl.crossed && extraBear
       && pl.currentLevel != 0.0) {

        string tag = (tb.bias == BULLISH) ? LBL_TAG_CHOCH : LBL_TAG_BOS;

        if(internalChannel) {
            if(tag == LBL_TAG_CHOCH) g_alerts.internalBearishCHoCH = true;
            else                     g_alerts.internalBearishBOS   = true;
        } else {
            if(tag == LBL_TAG_CHOCH) g_alerts.swingBearishCHoCH = true;
            else                     g_alerts.swingBearishBOS   = true;
        }

        if(internalChannel) { g_internalLow.crossed = true; g_internalTrend.bias = BEARISH; }
        else                { g_swingLow.crossed    = true; g_swingTrend.bias    = BEARISH; }

        bool show;
        ENUM_SMC_STRUCT_DISPLAY filt;
        if(internalChannel) { show = InpShowInternals;  filt = InpShowInternalBear; }
        else                { show = InpShowStructure;  filt = InpShowSwingBear;    }

        bool passFilter = (filt == SMC_ALL)
                        || (filt == SMC_BOS_ONLY  && tag != LBL_TAG_CHOCH)
                        || (filt == SMC_CHOCH_ONLY && tag == LBL_TAG_CHOCH);

        if(show && passFilter) {
            color c = internalChannel ? ResolveInternalBear() : ResolveSwingBear();
            ENUM_LINE_STYLE st = internalChannel ? STYLE_DASH : STYLE_SOLID;
            ENUM_SMC_LABEL_SIZE sz = internalChannel ? InpInternalLabelSize : InpSwingLabelSize;
            Pivot plCopy = pl;
            DrawStructure(plCopy, tag, c, st, sz, true, internalChannel, true);
        }

        if((internalChannel && InpShowInternalOBs) || (!internalChannel && InpShowSwingOBs)) {
            Pivot plCopy = pl;
            StoreOrderBlock(plCopy, internalChannel, BEARISH);
        }
    }
}

//===================== FAIR VALUE GAPS ==============================
void DeleteFairValueGaps() {
    double curH = H(0), curL = L(0);
    for(int i = ArraySize(g_fvgs) - 1; i >= 0; i--) {
        bool kill = false;
        if(g_fvgs[i].bias == BULLISH && curL < g_fvgs[i].bottom) kill = true;
        if(g_fvgs[i].bias == BEARISH && curH > g_fvgs[i].top)    kill = true;
        if(kill) {
            SafeDelete(OBJ_PREFIX + "fvgT_" + IntegerToString(g_fvgs[i].objId));
            SafeDelete(OBJ_PREFIX + "fvgB_" + IntegerToString(g_fvgs[i].objId));
            for(int j = i; j < ArraySize(g_fvgs) - 1; j++) g_fvgs[j] = g_fvgs[j + 1];
            ArrayResize(g_fvgs, ArraySize(g_fvgs) - 1);
        }
    }
}

void DrawFairValueGaps() {
    ENUM_TIMEFRAMES tf = InpFVGTimeframe == PERIOD_CURRENT ? _Period : InpFVGTimeframe;

    // MTF FVG (different TF than chart) is only supported in live mode.
    // Backfilling it would require mapping chart-TF scan positions to HTF bar
    // shifts, which adds complexity for a feature most users don't enable.
    bool isChartTF = (tf == _Period);
    if(!isChartTF && g_scanShift > 0) return;

    // For MTF: only evaluate when a new bar formed on that TF (live only)
    if(tf != _Period) {
        datetime cur = iTime(_Symbol, tf, 0);
        static datetime lastFvgTfBar = 0;
        if(cur == lastFvgTfBar) return;
        lastFvgTfBar = cur;
    }

    // When TF == chart TF, layer g_scanShift onto the lookback so backfill works.
    int extra = isChartTF ? g_scanShift : 0;

    // Pull last 3 bars on the chosen TF (closed)
    double last2H  = iHigh (_Symbol, tf, 3 + extra);
    double last2L  = iLow  (_Symbol, tf, 3 + extra);
    double lastC   = iClose(_Symbol, tf, 2 + extra);
    double lastO   = iOpen (_Symbol, tf, 2 + extra);
    datetime lastT = iTime (_Symbol, tf, 2 + extra);
    double curH    = iHigh (_Symbol, tf, 1 + extra);
    double curL    = iLow  (_Symbol, tf, 1 + extra);
    datetime curT  = iTime (_Symbol, tf, 1 + extra);

    if(lastO == 0 || last2H == 0) return;

    double barDeltaPct = (lastC - lastO) / (lastO * 100.0);
    double threshold = 0.0;
    if(InpFVGAutoThresh) {
        static double cumAbsDelta = 0.0;
        static int cumCount = 0;
        cumAbsDelta += MathAbs(barDeltaPct);
        cumCount++;
        threshold = (cumCount > 0) ? (cumAbsDelta / cumCount) * 2.0 : 0.0;
    }

    bool bullFVG = (curL > last2H) && (lastC > last2H) && (barDeltaPct >  threshold);
    bool bearFVG = (curH < last2L) && (lastC < last2L) && (-barDeltaPct > threshold);

    datetime rightT = curT + (int)((curT - lastT) * (InpFVGExtend + 1));

    if(bullFVG) {
        g_alerts.bullishFVG = true;
        FVGRec rec;
        rec.top = curL; rec.bottom = last2H; rec.bias = BULLISH; rec.active = true;
        rec.createdAt = curT;
        g_objCounter++;
        rec.objId = g_objCounter;
        color c = ResolveFVGBull();
        double mid = (curL + last2H) / 2.0;
        DrawRect(OBJ_PREFIX + "fvgT_" + IntegerToString(rec.objId), lastT, curL,  rightT, mid,    c, c, true);
        DrawRect(OBJ_PREFIX + "fvgB_" + IntegerToString(rec.objId), lastT, mid,   rightT, last2H, c, c, true);
        int n = ArraySize(g_fvgs);
        ArrayResize(g_fvgs, n + 1);
        for(int i = n; i > 0; i--) g_fvgs[i] = g_fvgs[i - 1];
        g_fvgs[0] = rec;
    }
    if(bearFVG) {
        g_alerts.bearishFVG = true;
        FVGRec rec;
        rec.top = curH; rec.bottom = last2L; rec.bias = BEARISH; rec.active = true;
        rec.createdAt = curT;
        g_objCounter++;
        rec.objId = g_objCounter;
        color c = ResolveFVGBear();
        double mid = (curH + last2L) / 2.0;
        DrawRect(OBJ_PREFIX + "fvgT_" + IntegerToString(rec.objId), lastT, curH,  rightT, mid,    c, c, true);
        DrawRect(OBJ_PREFIX + "fvgB_" + IntegerToString(rec.objId), lastT, mid,   rightT, last2L, c, c, true);
        int n = ArraySize(g_fvgs);
        ArrayResize(g_fvgs, n + 1);
        for(int i = n; i > 0; i--) g_fvgs[i] = g_fvgs[i - 1];
        g_fvgs[0] = rec;
    }
}

