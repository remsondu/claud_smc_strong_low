bool IsHigherTF(ENUM_TIMEFRAMES tf) {
    return PeriodSeconds(_Period) > PeriodSeconds(tf);
}

void DrawMTFLevels(ENUM_TIMEFRAMES tf, string tfTag, ENUM_SMC_LINESTYLE lineSt, color c) {
    if(IsHigherTF(tf)) return;

    double topLvl    = iHigh(_Symbol, tf, 1);
    double bottomLvl = iLow (_Symbol, tf, 1);
    if(topLvl == 0) return;

    datetime leftT  = iTime(_Symbol, tf, 1);
    datetime rightT = iTime(_Symbol, _Period, 0) + PeriodSeconds(_Period) * 20;

    string topLine = OBJ_PREFIX + "mtfTL_" + tfTag;
    string botLine = OBJ_PREFIX + "mtfBL_" + tfTag;
    string topTxt  = OBJ_PREFIX + "mtfTT_" + tfTag;
    string botTxt  = OBJ_PREFIX + "mtfBT_" + tfTag;

    DrawTrend(topLine, leftT, topLvl,    rightT, topLvl,    c, LineStyle(lineSt), 1, false);
    DrawTrend(botLine, leftT, bottomLvl, rightT, bottomLvl, c, LineStyle(lineSt), 1, false);
    DrawText (topTxt,  rightT, topLvl,    "P" + tfTag + "H", c, 8, ANCHOR_LEFT);
    DrawText (botTxt,  rightT, bottomLvl, "P" + tfTag + "L", c, 8, ANCHOR_LEFT);
}

