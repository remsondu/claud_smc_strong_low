    int panelW = cRe + 120;
    int panelH = rowH * (MTF_COUNT + 3) + 10;

    PanelBG(OBJ_PREFIX + "pnl_bg", x0 - 6, y0 - 6, panelW, panelH, InpPanelBgColor);

    double px = SymbolInfoDouble(_Symbol, SYMBOL_BID);
    PanelLabel(OBJ_PREFIX + "pnl_title", x0, y0,
               "MTF STRONG/WEAK  " + _Symbol + "  " + DoubleToString(px, _Digits),
               clrWhite, fs);

    int hy = y0 + rowH;
    PanelLabel(OBJ_PREFIX + "pnl_h_tf",   x0 + cTF,   hy, "TF",     InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "pnl_h_bias", x0 + cBias, hy, "Bias",   InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "pnl_h_sh",   x0 + cSH,   hy, "S.High", InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "pnl_h_wh",   x0 + cWH,   hy, "W.High", InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "pnl_h_sl",   x0 + cSL,   hy, "S.Low",  InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "pnl_h_wl",   x0 + cWL,   hy, "W.Low",  InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "pnl_h_re",   x0 + cRe,   hy, "React",  InpPanelTextColor, fs);

    for(int i = 0; i < MTF_COUNT; i++) {
        MTFLevel m = g_mtf[i];
        int ry = y0 + rowH * (i + 2);
        string id = IntegerToString(i);

        // v1.13: highlight the row when price is trading inside this TF's strong↔weak band.
        // Drawn BEFORE this row's labels so the text stays on top of the highlight.
        string hlName    = OBJ_PREFIX + "pnl_hl_" + id;
        bool   rowInPlay = (InpMTFHighlightInPlay && m.valid && m.inPlay);
        if(rowInPlay) PanelBG(hlName, x0 - 4, ry - 3, panelW - 4, rowH, InpMTFInPlayColor);
        else          SafeDelete(hlName);

        color  tfC   = rowInPlay ? InpMTFInPlayTagColor : clrWhite;
        string tfTxt = (rowInPlay ? "> " : "") + m.tag;
        PanelLabel(OBJ_PREFIX + "pnl_tf_" + id, x0 + cTF, ry, tfTxt, tfC, fs);

        if(!m.valid) {
            PanelLabel(OBJ_PREFIX + "pnl_bias_" + id, x0 + cBias, ry, "n/a", InpPanelDimColor, fs);
            PanelLabel(OBJ_PREFIX + "pnl_sh_"   + id, x0 + cSH,   ry, "-",   InpPanelDimColor, fs);
            PanelLabel(OBJ_PREFIX + "pnl_wh_"   + id, x0 + cWH,   ry, "-",   InpPanelDimColor, fs);
            PanelLabel(OBJ_PREFIX + "pnl_sl_"   + id, x0 + cSL,   ry, "-",   InpPanelDimColor, fs);
            PanelLabel(OBJ_PREFIX + "pnl_wl_"   + id, x0 + cWL,   ry, "-",   InpPanelDimColor, fs);
            PanelLabel(OBJ_PREFIX + "pnl_re_"   + id, x0 + cRe,   ry, "-",   InpPanelDimColor, fs);
            continue;
        }

        color  biasC = m.bias == BULLISH ? InpPanelBullColor
                     : m.bias == BEARISH ? InpPanelBearColor : InpPanelDimColor;
        string biasT = m.bias == BULLISH ? "BULL" : m.bias == BEARISH ? "BEAR" : "RNG";
        string pdT   = m.pricePD > 0 ? " P" : m.pricePD < 0 ? " D" : " E";
        PanelLabel(OBJ_PREFIX + "pnl_bias_" + id, x0 + cBias, ry, biasT + pdT, biasC, fs);

        // which cells are the ACTIVE pair for current bias (bright); target weak = gold
        bool shActive = (m.bias == BEARISH);
        bool whActive = (m.bias == BULLISH);
        bool slActive = (m.bias == BULLISH);
        bool wlActive = (m.bias == BEARISH);

        PanelLabel(OBJ_PREFIX + "pnl_sh_" + id, x0 + cSH, ry, DoubleToString(m.strongHigh, _Digits),
                   shActive ? InpPanelBearColor : InpPanelDimColor, fs);
        PanelLabel(OBJ_PREFIX + "pnl_wh_" + id, x0 + cWH, ry, DoubleToString(m.weakHigh, _Digits),
                   whActive ? clrGold : InpPanelDimColor, fs);
        PanelLabel(OBJ_PREFIX + "pnl_sl_" + id, x0 + cSL, ry, DoubleToString(m.strongLow, _Digits),
                   slActive ? InpPanelBullColor : InpPanelDimColor, fs);
        PanelLabel(OBJ_PREFIX + "pnl_wl_" + id, x0 + cWL, ry, DoubleToString(m.weakLow, _Digits),
                   wlActive ? clrGold : InpPanelDimColor, fs);

        string reT; color reC;
        switch(m.state) {
            case MTF_HOLD_BULL:   reT = "HOLD UP"; reC = InpPanelBullColor; break;
            case MTF_HOLD_BEAR:   reT = "HOLD DN"; reC = InpPanelBearColor; break;
            case MTF_BROKEN_HIGH: reT = "BRK HI";  reC = clrOrange;         break;
            case MTF_BROKEN_LOW:  reT = "BRK LO";  reC = clrOrange;         break;
            default:              reT = "-";       reC = InpPanelDimColor;  break;
        }
        PanelLabel(OBJ_PREFIX + "pnl_re_" + id, x0 + cRe, ry, reT, reC, fs);
    }

    int fy = y0 + rowH * (MTF_COUNT + 2);
    PanelLabel(OBJ_PREFIX + "pnl_foot", x0 + cTF, fy,
               "bright=active | gold=target | reject strong -> take opposite weak",
               InpPanelDimColor, MathMax(6, fs - 1));
}

// Recompute every timeframe, optionally evaluate the closed chart bar for reactions,
// then redraw the panel.
void UpdateMTF(bool evaluateReactions) {
    for(int i = 0; i < MTF_COUNT; i++) {
        AnalyzeTF(g_mtf[i]);
        if(evaluateReactions) EvaluateReaction(g_mtf[i]);
    }
    RefreshMTFPanel();
}

//===================== LIQUIDITY SEQUENCE TRACKER (v1.13) ===========
//
// Pattern being tracked (bullish shown; bearish is the exact mirror):
//
//   1) BREAK        A CHoCH/BOS confirms up (a bar CLOSES above a prior pivot high).
//                   The leg that broke it originated from a demand ORDER BLOCK below,
//                   and it left the last minor swing LOW untested — that low is the
//                   INDUCEMENT (the "left-behind" liquidity you marked in black).
//   2) RETRACE      Price trades back down from the break toward the OB.
//   3) (sweep)      On the way it usually runs the inducement low (grabs liquidity).
//   4) MITIGATED    Price taps the OB zone (wick into [obBottom .. obTop] ± tolerance).
//   5) CONTINUATION "Original move begins": after the tap, a bar closes back in the
//                   break direction beyond the OB  →  trigger fires.
//   INVALID         A close clean through the OB voids the sequence.
//
// This is recomputed statelessly per (TF × channel) each chart bar, so it is
// restart-safe and always reflects the MOST RECENT break on that TF/channel.
// "Internal" vs "swing/external" is just a different pivot length per the inputs.
// No trading is wired here — it drives the panel, chart objects and alerts only.

string LiqObjBase(LiqSequence &s) {
    return OBJ_PREFIX + "liq_" + s.tag + "_" + (s.internalCh ? "INT" : "EXT") + "_";
}

void DeleteLiqObjects(LiqSequence &s) {
    DeleteByPrefix(LiqObjBase(s));
}

string LiqPhaseText(ENUM_SEQ_STATE st) {
    switch(st) {
        case SEQ_BREAK:        return "BREAK";
        case SEQ_RETRACE:      return "RETRACE";
        case SEQ_MITIGATED:    return "AT OB";
        case SEQ_CONTINUATION: return "GO";
        case SEQ_INVALID:      return "VOID";
        default:               return "-";
    }
}

void LiqAlert(LiqSequence &s, string ev) {
    if(!InpAlertsOn && !InpPushNotifyOn) return;

    string dir  = (s.dir == BULLISH) ? "Bull" : "Bear";
    string ch   = s.internalCh ? "INT" : "EXT";
    string kind = s.isChoCH ? "CHoCH" : "BOS";
    string msg;

    if(ev == "BREAK")
        msg = StringFormat("%s %s %s %s %s | inducement %s, OB %s-%s",
              _Symbol, s.tag, ch, dir, kind,
              DoubleToString(s.induceLevel, _Digits),
              DoubleToString(s.obBottom, _Digits), DoubleToString(s.obTop, _Digits));
    else if(ev == "MITIGATE")
        msg = StringFormat("%s %s %s %s: price tapped OB %s-%s (inducement %s)",
              _Symbol, s.tag, ch, dir,
              DoubleToString(s.obBottom, _Digits), DoubleToString(s.obTop, _Digits),
              s.induceSwept ? "swept" : "not swept");
    else // CONTINUE
        msg = StringFormat("%s %s %s %s: ORIGINAL MOVE resuming from OB (continuation)",
              _Symbol, s.tag, ch, dir);

    if(InpAlertsOn)     Alert("SMC LIQ | " + msg);
    if(InpPushNotifyOn) SendNotification("SMC LIQ " + msg);
}

// Analyse one (TF × channel): find the most recent break, its inducement + OB,
// then step the state machine over the bars that followed. Alerts fire only when
// allowAlerts is true AND the triggering bar is new (debounced per event).
void LiqAnalyzeChannel(ENUM_TIMEFRAMES tf, int pivLen, bool internalCh,
                       LiqSequence &s, bool allowAlerts) {
    s.tf         = tf;
    s.tag        = TFName(tf);
    s.internalCh = internalCh;

    int avail = Bars(_Symbol, tf);
    int scan  = MathMin(InpLiqScanBars, avail);
    if(scan < 2 * pivLen + 20) { s.active = false; s.state = SEQ_IDLE; s.dir = 0; return; }

    // --- replay structure old→new to locate the most recent break ---
    double   lastHigh = 0, lastLow = 0;
    datetime lastHighT = 0, lastLowT = 0;
    bool     haveHigh = false, haveLow = false;
    int      trend = NEUTRAL;

    bool     foundBreak = false, brChoCH = false;
    int      brDir = 0, brShift = 0;
    double   brPivot = 0, brInduce = 0;
    datetime brTime = 0, brInduceT = 0;

    for(int sft = scan - 1 - pivLen; sft >= 1 + pivLen; sft--) {
        bool isHi = (iHighest(_Symbol, tf, MODE_HIGH, 2 * pivLen + 1, sft - pivLen) == sft);
        bool isLo = (iLowest (_Symbol, tf, MODE_LOW,  2 * pivLen + 1, sft - pivLen) == sft);
        double c = iClose(_Symbol, tf, sft);

        // break check uses pivots confirmed on OLDER bars (registered in prior iterations)
        if(haveHigh && c > lastHigh) {
            brDir = BULLISH; brPivot = lastHigh; brTime = iTime(_Symbol, tf, sft); brShift = sft;
            brChoCH  = (trend == BEARISH);
            brInduce = haveLow ? lastLow  : 0;  brInduceT = haveLow ? lastLowT : 0;
            foundBreak = true; trend = BULLISH;
            haveHigh = false;                   // need a fresh high before the next bull break
        }
        else if(haveLow && c < lastLow) {
            brDir = BEARISH; brPivot = lastLow; brTime = iTime(_Symbol, tf, sft); brShift = sft;
            brChoCH  = (trend == BULLISH);
            brInduce = haveHigh ? lastHigh : 0; brInduceT = haveHigh ? lastHighT : 0;
            foundBreak = true; trend = BEARISH;
            haveLow = false;
        }

        // register this bar's fractal(s) AFTER the break check
        if(isHi) { lastHigh = iHigh(_Symbol, tf, sft); lastHighT = iTime(_Symbol, tf, sft); haveHigh = true; }
        if(isLo) { lastLow  = iLow (_Symbol, tf, sft); lastLowT  = iTime(_Symbol, tf, sft); haveLow  = true; }
    }

    if(!foundBreak) { s.active = false; s.state = SEQ_IDLE; s.dir = 0; return; }

    // --- order block: last opposite-color candle before the breaking leg ---
    double   obTop = 0, obBot = 0; datetime obT = 0; bool obOK = false;
    int maxBack = brShift + InpLiqOBLookback;
    for(int sft = brShift; sft <= maxBack; sft++) {
        double o  = iOpen (_Symbol, tf, sft);
        double c2 = iClose(_Symbol, tf, sft);
        if(brDir == BULLISH && c2 < o) {                 // demand OB = last down candle
            obTop = iHigh(_Symbol, tf, sft); obBot = iLow(_Symbol, tf, sft);
            obT = iTime(_Symbol, tf, sft); obOK = true; break;
        }
        if(brDir == BEARISH && c2 > o) {                 // supply OB = last up candle
            obTop = iHigh(_Symbol, tf, sft); obBot = iLow(_Symbol, tf, sft);
            obT = iTime(_Symbol, tf, sft); obOK = true; break;
        }
    }

    // --- step the state machine over bars that followed the break (brShift-1 → 1) ---
    ENUM_SEQ_STATE st = SEQ_BREAK;
    bool swept = false, tapped = false, cont = false;
    datetime contT = 0, mitT = 0;
    double tol = obOK ? (obTop - obBot) * InpLiqTapTolFrac : 0;

    for(int sft = brShift - 1; sft >= 1; sft--) {
        double hi = iHigh (_Symbol, tf, sft);
        double lo = iLow  (_Symbol, tf, sft);
        double o  = iOpen (_Symbol, tf, sft);
        double c  = iClose(_Symbol, tf, sft);
        datetime t = iTime(_Symbol, tf, sft);

        if(brDir == BULLISH) {
            if(brInduce > 0 && lo < brInduce) swept = true;
            if(obOK && c < obBot - tol) { st = SEQ_INVALID; break; }      // OB blown
            if(obOK && !tapped && lo <= obTop + tol) { tapped = true; mitT = t; if(st < SEQ_MITIGATED) st = SEQ_MITIGATED; }
            if(obOK && tapped) {
                bool sweepOK = (!InpLiqRequireSweep || swept || brInduce <= 0);
                if(sweepOK && c > o && c > obTop) { cont = true; contT = t; st = SEQ_CONTINUATION; break; }
            }
            if(st == SEQ_BREAK) st = SEQ_RETRACE;
        }
        else { // BEARISH
            if(brInduce > 0 && hi > brInduce) swept = true;
            if(obOK && c > obTop + tol) { st = SEQ_INVALID; break; }
            if(obOK && !tapped && hi >= obBot - tol) { tapped = true; mitT = t; if(st < SEQ_MITIGATED) st = SEQ_MITIGATED; }
            if(obOK && tapped) {
                bool sweepOK = (!InpLiqRequireSweep || swept || brInduce <= 0);
                if(sweepOK && c < o && c < obBot) { cont = true; contT = t; st = SEQ_CONTINUATION; break; }
            }
            if(st == SEQ_BREAK) st = SEQ_RETRACE;
        }
    }

    // --- commit to the slot ---
    s.active      = true;
    s.dir         = brDir;
    s.state       = st;
    s.brokenPivot = brPivot;
    s.breakTime   = brTime;
    s.isChoCH     = brChoCH;
    s.induceLevel = brInduce;
    s.induceTime  = brInduceT;
    s.induceSwept = swept;
    s.obTop       = obTop;
    s.obBottom    = obBot;
    s.obTime      = obT;
    s.obValid     = obOK;
    s.contBarTime = contT;

    // --- alerts (debounced by event bar time; load/timer passes record without firing) ---
    if(s.aBreak != brTime) {
        if(InpLiqAlertBreak && allowAlerts) LiqAlert(s, "BREAK");
        s.aBreak = brTime;
    }
    if(tapped && s.aMit != mitT) {
        if(InpLiqAlertMitigate && allowAlerts) LiqAlert(s, "MITIGATE");
        s.aMit = mitT;
    }
    if(cont && s.aCont != contT) {
        if(InpLiqAlertContinue && allowAlerts) LiqAlert(s, "CONTINUE");
        s.aCont = contT;
    }
}

// Draw one sequence's visuals: OB top/bottom, the inducement level, and a
// continuation arrow once the move resumes. Only the actionable phases are drawn.
//
// When the sequence's TF == the current chart ("native"), objects anchor at their
// REAL bar times (OB at its origin candle, inducement at its pivot), so each
// timeframe's picture sits correctly on its own chart. When projecting a different
// TF onto this chart (ALL scope), prices are valid across TFs but the bar times are
// not, so those use horizontal segments spanning a fixed window instead.
void DrawLiqObjects(LiqSequence &s) {
    DeleteLiqObjects(s);
    if(!InpLiqDrawObjects) return;
    if(!s.active || s.dir == 0)                        return;
    if(s.state == SEQ_IDLE || s.state == SEQ_INVALID)  return;

    color    cDir   = (s.dir == BULLISH) ? InpLiqBullColor : InpLiqBearColor;
    string   b      = LiqObjBase(s);
    string   chTag  = s.internalCh ? "INT" : "EXT";
    datetime nowT   = iTime(_Symbol, _Period, 0);
    datetime rightT = nowT + PeriodSeconds(_Period) * 12;
    datetime projL  = nowT - PeriodSeconds(_Period) * 220;

    bool     native  = (s.tf == _Period);
    datetime obLeft  = (native && s.obTime     > 0) ? s.obTime     : projL;
    datetime indLeft = (native && s.induceTime > 0) ? s.induceTime : projL;

    if(s.obValid) {
        DrawTrend(b + "obT", obLeft, s.obTop,    rightT, s.obTop,    cDir, STYLE_SOLID, 1, false);
        DrawTrend(b + "obB", obLeft, s.obBottom, rightT, s.obBottom, cDir, STYLE_SOLID, 1, false);
        DrawText (b + "obtx", rightT, s.obTop, s.tag + " " + chTag + " OB", cDir, 7, ANCHOR_LEFT);
    }
    if(s.induceLevel > 0) {
        DrawTrend(b + "ind", indLeft, s.induceLevel, rightT, s.induceLevel,
                  InpLiqInduceColor, STYLE_DOT, 1, false);
        DrawText (b + "indtx", rightT, s.induceLevel,
                  s.tag + " induce" + (s.induceSwept ? " (swept)" : ""),
                  InpLiqInduceColor, 7, ANCHOR_LEFT);
    }
    if(s.state == SEQ_CONTINUATION) {
        string   an = b + "arr";
        double   ap = (s.dir == BULLISH) ? s.obBottom : s.obTop;
        datetime at = (native && s.contBarTime > 0) ? s.contBarTime : iTime(_Symbol, _Period, 1);
        if(ObjectFind(0, an) < 0) ObjectCreate(0, an, OBJ_ARROW, 0, at, ap);
        ObjectMove(0, an, 0, at, ap);
        ObjectSetInteger(0, an, OBJPROP_ARROWCODE,  (s.dir == BULLISH) ? 233 : 234);
        ObjectSetInteger(0, an, OBJPROP_COLOR,      cDir);
        ObjectSetInteger(0, an, OBJPROP_WIDTH,      2);
        ObjectSetInteger(0, an, OBJPROP_SELECTABLE, false);
        ObjectSetInteger(0, an, OBJPROP_HIDDEN,     true);
    }
}

void DeleteLiqPanel() { DeleteByPrefix(OBJ_PREFIX + "lqp_"); }

// Compact second panel, one row per (TF × channel), placed below the MTF panel.
void RefreshLiqPanel() {
    if(!InpLiqEnable) { DeleteLiqPanel(); return; }

    int fs   = InpPanelFontSize;
    int rowH = fs + 8;
    int x0   = InpPanelX;
    int mtfH = rowH * (MTF_COUNT + 3) + 10;
    int y0   = InpPanelY + (InpShowMTFPanel ? mtfH + InpLiqPanelGap : 0);

    int cTF = 0, cCh = 42, cDir = 82, cPh = 128, cInd = 196, cOB = 272, cTr = 362;
    int panelW = cTr + 72;

    int chRows = (InpLiqTrackInternal ? 1 : 0) + (InpLiqTrackSwing ? 1 : 0);
    int rows   = g_liqTFCount * chRows;
    int panelH = rowH * (rows + 3) + 10;

    PanelBG(OBJ_PREFIX + "lqp_bg", x0 - 6, y0 - 6, panelW, panelH, InpPanelBgColor);
    PanelLabel(OBJ_PREFIX + "lqp_title", x0, y0, "LIQUIDITY SEQUENCE  " + _Symbol, clrWhite, fs);

    int hy = y0 + rowH;
    PanelLabel(OBJ_PREFIX + "lqp_h_tf",  x0 + cTF,  hy, "TF",     InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "lqp_h_ch",  x0 + cCh,  hy, "Ch",     InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "lqp_h_dir", x0 + cDir, hy, "Dir",    InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "lqp_h_ph",  x0 + cPh,  hy, "Phase",  InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "lqp_h_ind", x0 + cInd, hy, "Induce", InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "lqp_h_ob",  x0 + cOB,  hy, "OB mid", InpPanelTextColor, fs);
    PanelLabel(OBJ_PREFIX + "lqp_h_tr",  x0 + cTr,  hy, "Trig",   InpPanelTextColor, fs);

    int r = 0;
    for(int k = 0; k < g_liqTFCount; k++) {
        for(int ch = 0; ch < LIQ_CH_COUNT; ch++) {
            if(ch == 0 && !InpLiqTrackInternal) continue;
            if(ch == 1 && !InpLiqTrackSwing)    continue;

            LiqSequence s = g_liq[k][ch];
            int ry = y0 + rowH * (r + 2); r++;
            string id = IntegerToString(k) + "_" + IntegerToString(ch);
            string dispTag = s.tag + ((k == g_liqCurRow) ? "*" : "");

            PanelLabel(OBJ_PREFIX + "lqp_tf_" + id, x0 + cTF, ry, dispTag, clrWhite, fs);
            PanelLabel(OBJ_PREFIX + "lqp_ch_" + id, x0 + cCh, ry, (ch == 0 ? "INT" : "EXT"),
                       InpPanelTextColor, fs);

            if(!s.active || s.dir == 0) {
                PanelLabel(OBJ_PREFIX + "lqp_dir_" + id, x0 + cDir, ry, "-",    InpPanelDimColor, fs);
                PanelLabel(OBJ_PREFIX + "lqp_ph_"  + id, x0 + cPh,  ry, "idle", InpPanelDimColor, fs);
                PanelLabel(OBJ_PREFIX + "lqp_ind_" + id, x0 + cInd, ry, "-",    InpPanelDimColor, fs);
                PanelLabel(OBJ_PREFIX + "lqp_ob_"  + id, x0 + cOB,  ry, "-",    InpPanelDimColor, fs);
                PanelLabel(OBJ_PREFIX + "lqp_tr_"  + id, x0 + cTr,  ry, "-",    InpPanelDimColor, fs);
                continue;
            }

            color  dc = (s.dir == BULLISH) ? InpPanelBullColor : InpPanelBearColor;
            string dt = (s.dir == BULLISH) ? "BULL" : "BEAR";
            dt += s.isChoCH ? " C" : " B";
            PanelLabel(OBJ_PREFIX + "lqp_dir_" + id, x0 + cDir, ry, dt, dc, fs);

            color pc = InpPanelTextColor;
            if(s.state == SEQ_CONTINUATION)   pc = dc;
            else if(s.state == SEQ_MITIGATED) pc = clrGold;
            else if(s.state == SEQ_INVALID)   pc = InpPanelDimColor;
            PanelLabel(OBJ_PREFIX + "lqp_ph_" + id, x0 + cPh, ry, LiqPhaseText(s.state), pc, fs);

            string indt = (s.induceLevel > 0) ? DoubleToString(s.induceLevel, _Digits) : "-";
            PanelLabel(OBJ_PREFIX + "lqp_ind_" + id, x0 + cInd, ry, indt,
                       s.induceSwept ? clrGold : InpPanelDimColor, fs);

            string obt = s.obValid ? DoubleToString((s.obTop + s.obBottom) / 2.0, _Digits) : "-";
            PanelLabel(OBJ_PREFIX + "lqp_ob_" + id, x0 + cOB, ry, obt, dc, fs);

            string tr = (s.state == SEQ_CONTINUATION) ? "FIRED"
                      : (s.state == SEQ_MITIGATED)    ? "ARMED" : "-";
            color  trc = (s.state == SEQ_CONTINUATION) ? dc
                       : (s.state == SEQ_MITIGATED)    ? clrGold : InpPanelDimColor;
            PanelLabel(OBJ_PREFIX + "lqp_tr_" + id, x0 + cTr, ry, tr, trc, fs);
        }
    }

    int fy = y0 + rowH * (rows + 2);
    PanelLabel(OBJ_PREFIX + "lqp_foot", x0 + cTF, fy,
               "C=CHoCH B=BOS | *=current chart | gold=swept / at OB | GO=move resuming",
               InpPanelDimColor, MathMax(6, fs - 1));
}

// Recompute every (TF × channel), redraw chart objects + panel.
// allowAlerts = true only on a closed CHART bar (OnTick new bar); false on load.
void UpdateLiq(bool allowAlerts) {
    if(!InpLiqEnable) { DeleteLiqPanel(); return; }
    for(int k = 0; k < g_liqTFCount; k++) {
        if(InpLiqTrackInternal)
            LiqAnalyzeChannel(g_liqTF[k], InpLiqIntLength,   true,  g_liq[k][0], allowAlerts);
        if(InpLiqTrackSwing)
            LiqAnalyzeChannel(g_liqTF[k], InpLiqSwingLength, false, g_liq[k][1], allowAlerts);

        // each TF draws its own visuals: by default only the row matching the chart
        // period draws; LIQ_SCOPE_ALL projects every tracked TF onto this chart.
        bool drawThisTF = InpLiqDrawObjects &&
                          (InpLiqDrawScope == LIQ_SCOPE_ALL || g_liqTF[k] == _Period);
        for(int ch = 0; ch < LIQ_CH_COUNT; ch++) {
            if(ch == 0 && !InpLiqTrackInternal) continue;
            if(ch == 1 && !InpLiqTrackSwing)    continue;
            if(drawThisTF) DrawLiqObjects(g_liq[k][ch]);
            else           DeleteLiqObjects(g_liq[k][ch]);  // clear stale objects for non-current TFs
        }
    }
    RefreshLiqPanel();
}

//===================== HISTORICAL BACKFILL ==========================
// Replay pivot detection, structure breaks, OB tracking, FVG detection
// and trailing extremes over the most recent N closed bars so all the
// historical structures show up immediately when the EA loads.
//
// Trading is never invoked here — RunTradingLogic is only called from
// OnTick, so backfill cannot produce phantom historical entries.
void BackfillHistory() {
    int totalBars = Bars(_Symbol, _Period);
    int scanBars  = MathMin(InpBackfillBars, totalBars - InpSwingsLength - 50);
    if(scanBars < InpSwingsLength * 2 + 50) {
        PrintFormat("[SMC] Backfill skipped — not enough history (%d bars available)", totalBars);
        return;
    }

    PrintFormat("[SMC] Backfilling %d historical bars...", scanBars);
    uint t0 = GetTickCount();

    // Walk old → new. At k=scanBars the "current closed bar" is the oldest
    // we'll scan; at k=1 it's the most recent closed bar (live equivalent).
    for(int k = scanBars; k >= 1; k--) {
        g_scanShift = k - 1;

        ResetAlerts();            // suppress per-bar alerts during scan
        UpdateCumTR();

        // Pivot capture (same calls as OnTick)
        GetCurrentStructure(InpSwingsLength, false, false);   // swing
        GetCurrentStructure(5,                false, true);    // internal
        if(InpShowEQHEQL)
            GetCurrentStructure(InpEQHEQLLength, true, false); // equal

        // FVG: mitigate-then-detect at each historical bar so live state
        // matches what would have happened if EA was running all along.
        // Skipped automatically for MTF FVGs (see DrawFairValueGaps).
        if(InpShowFVG) {
            DeleteFairValueGaps();
            DrawFairValueGaps();
        }

        // Structure breaks — also calls StoreOrderBlock internally.
        if(InpShowInternals || InpShowInternalOBs)
            DisplayStructure(true);
        if(InpShowStructure || InpShowSwingOBs || InpShowHighLowSwings)
            DisplayStructure(false);

        // OB mitigation against the current scanned bar's range.
        if(InpShowInternalOBs) DeleteOrderBlocks(true);
        if(InpShowSwingOBs)    DeleteOrderBlocks(false);

        // Trailing extremes accumulate bar-by-bar.
        if(InpShowHighLowSwings || InpShowPDZones)
            UpdateTrailingExtremes();
    }

    g_scanShift   = 0;
    g_lastBarTime = iTime(_Symbol, _Period, 0);  // prevent OnTick reprocessing the latest bar
    ResetAlerts();

    PrintFormat("[SMC] Backfill done in %u ms — %d swing OBs, %d internal OBs, %d active FVGs",
                GetTickCount() - t0,
                ArraySize(g_swingOBs), ArraySize(g_internalOBs), ArraySize(g_fvgs));
}

//===================== ONINIT / ONDEINIT ============================
int OnInit() {
    g_atrHandle   = iATR(_Symbol, _Period, 200);
    g_atr14Handle = iATR(_Symbol, _Period, 14);
    if(g_atrHandle == INVALID_HANDLE || g_atr14Handle == INVALID_HANDLE) {
        Print("[SMC] ATR handle creation failed");
        return INIT_FAILED;
    }

    g_sym.Name(_Symbol);
    g_sym.RefreshRates();

    g_trade.SetExpertMagicNumber(InpMagicNumber);
    g_trade.SetDeviationInPoints(InpSlippagePoints);
    g_trade.SetMarginMode();
    g_trade.SetTypeFillingBySymbol(_Symbol);

    InitPivot(g_swingHigh);    InitPivot(g_swingLow);
    InitPivot(g_internalHigh); InitPivot(g_internalLow);
    InitPivot(g_equalHigh);    InitPivot(g_equalLow);
    g_swingTrend.bias    = NEUTRAL;
    g_internalTrend.bias = NEUTRAL;

    g_trailing.top            = -DBL_MAX;
    g_trailing.bottom         = DBL_MAX;
    g_trailing.barTime        = 0;
    g_trailing.lastTopTime    = 0;
    g_trailing.lastBottomTime = 0;

    g_swingLeg = 0; g_swingLegPrev = 0;
    g_internalLeg = 0; g_internalLegPrev = 0;
    g_equalLeg = 0; g_equalLegPrev = 0;

    g_cumTR = 0.0; g_processedBars = 0;
    g_lastBarTime = 0;
    g_initialTime = 0;
    g_scanShift = 0;
    ResetAlerts();

    ArrayResize(g_swingOBs, 0);
    ArrayResize(g_internalOBs, 0);
    ArrayResize(g_fvgs, 0);

    // v1.12: init MTF dashboard rows
    g_mtf[0].tf = InpMTF1; g_mtf[1].tf = InpMTF2;
    g_mtf[2].tf = InpMTF3; g_mtf[3].tf = InpMTF4;
    for(int i = 0; i < MTF_COUNT; i++) {
        g_mtf[i].tag          = TFName(g_mtf[i].tf);
        g_mtf[i].valid        = false;
        g_mtf[i].state        = MTF_NONE;
        g_mtf[i].lastReactBar = 0;
    }

    // v1.13: build the tracked-timeframe list = MTF rows + (optional) current chart row.
    g_liqTFCount = 0;
    g_liqCurRow  = -1;
    for(int i = 0; i < MTF_COUNT; i++) {
        g_liqTF[g_liqTFCount] = g_mtf[i].tf;
        if(g_mtf[i].tf == _Period) g_liqCurRow = g_liqTFCount;   // chart TF already in the MTF set
        g_liqTFCount++;
    }
    if(InpLiqIncludeCurrent && g_liqCurRow < 0) {                 // add the chart TF as its own row
        g_liqTF[g_liqTFCount] = _Period;
        g_liqCurRow = g_liqTFCount;
        g_liqTFCount++;
    }

    // init every slot in the list
    for(int k = 0; k < g_liqTFCount; k++) {
        for(int ch = 0; ch < LIQ_CH_COUNT; ch++) {
            g_liq[k][ch].tf          = g_liqTF[k];
            g_liq[k][ch].tag         = TFName(g_liqTF[k]);
            g_liq[k][ch].internalCh  = (ch == 0);
            g_liq[k][ch].active      = false;
            g_liq[k][ch].state       = SEQ_IDLE;
            g_liq[k][ch].dir         = 0;
            g_liq[k][ch].induceSwept = false;
            g_liq[k][ch].obValid     = false;
            g_liq[k][ch].aBreak      = 0;
            g_liq[k][ch].aMit        = 0;
            g_liq[k][ch].aCont       = 0;
        }
    }

    // ATR buffer needs a moment to populate after handle creation. Wait briefly
    // (especially important on slow brokers / fresh symbol load) so backfill
    // doesn't run with GetATR returning 0.
    if(InpBackfillOnInit) {
        int waitMs = 0;
        double atrCheck[];
        while(waitMs < 3000) {
            if(CopyBuffer(g_atrHandle, 0, 1, 1, atrCheck) >= 1) break;
            Sleep(50);
            waitMs += 50;
        }
        BackfillHistory();

        // Final draw passes: now that g_scanShift == 0, the right edges
        // anchor to the live "now" instead of to historical scan positions.
        if(InpShowInternalOBs)   DrawOrderBlocks(true);
        if(InpShowSwingOBs)      DrawOrderBlocks(false);
        if(InpShowHighLowSwings) DrawHighLowSwings();
        if(InpShowPDZones)       DrawPremiumDiscountZones();
        if(InpShowDaily)   DrawMTFLevels(PERIOD_D1, "D", InpDailyStyle,   InpDailyColor);
        if(InpShowWeekly)  DrawMTFLevels(PERIOD_W1, "W", InpWeeklyStyle,  InpWeeklyColor);
        if(InpShowMonthly) DrawMTFLevels(PERIOD_MN1,"M", InpMonthlyStyle, InpMonthlyColor);
        ChartRedraw();
    }

    // v1.12: first MTF pass (no reaction alerts on load — just populate the panel)
    if(InpShowMTFPanel) {
        UpdateMTF(false);
        ChartRedraw();
    }

    // v1.13: first liquidity-sequence pass (record state, no alerts on load)
    if(InpLiqEnable) {
        UpdateLiq(false);
        ChartRedraw();
    }

    EventSetTimer(15);
    Print("[SMC] EA initialized on ", _Symbol, " ", EnumToString(_Period));
    return INIT_SUCCEEDED;
}

void OnDeinit(const int reason) {
    EventKillTimer();
    if(g_atrHandle   != INVALID_HANDLE) IndicatorRelease(g_atrHandle);
    if(g_atr14Handle != INVALID_HANDLE) IndicatorRelease(g_atr14Handle);
    DeleteByPrefix(OBJ_PREFIX);   // also removes pnl_* dashboard objects
    ChartRedraw();
}

//===================== ONTIMER ======================================
void OnTimer() {
    // Lightweight cleanup pass — re-run mitigation in case ticks were missed
    if(InpShowInternalOBs) DeleteOrderBlocks(true);
    if(InpShowSwingOBs)    DeleteOrderBlocks(false);
    if(InpShowFVG)         DeleteFairValueGaps();
    ManageOpenPositions();

    // v1.12: keep the MTF panel levels + price fresh between chart bars.
    // Reaction alerts are NOT fired here (they must evaluate a closed chart bar),
    // so pass evaluateReactions = false.
    if(InpShowMTFPanel) {
        UpdateMTF(false);
        ChartRedraw();
    }
}

//===================== ONTICK =======================================
void OnTick() {
    bool newBar = IsNewBar();
    if(!newBar && !InpProcessOnTick) {
        // still manage positions on every tick if trailing is on
        if(InpEnableTrading) ManageOpenPositions();
        return;
    }

    // Warm-up guard
    if(Bars(_Symbol, _Period) < MathMax(250, InpSwingsLength + 50)) return;

    // Anchor for "initial time"
    if(g_initialTime == 0) g_initialTime = T(0);

    ResetAlerts();
    UpdateCumTR();

    // Pivot capture
    GetCurrentStructure(InpSwingsLength, false, false);          // swing
    GetCurrentStructure(5,                false, true);           // internal
    if(InpShowEQHEQL)
        GetCurrentStructure(InpEQHEQLLength, true, false);        // equal

    // FVG (delete first, then draw fresh)
    if(InpShowFVG) DeleteFairValueGaps();

    // Structure breaks
    if(InpShowInternals || InpShowInternalOBs)
        DisplayStructure(true);
    if(InpShowStructure || InpShowSwingOBs || InpShowHighLowSwings)
        DisplayStructure(false);

    // OB mitigation
    if(InpShowInternalOBs) DeleteOrderBlocks(true);
    if(InpShowSwingOBs)    DeleteOrderBlocks(false);

    // Draw OBs (fresh each bar for last N)
    if(InpShowInternalOBs) DrawOrderBlocks(true);
    if(InpShowSwingOBs)    DrawOrderBlocks(false);

    // FVG draw
    if(InpShowFVG) DrawFairValueGaps();

    // Trailing extremes + zones
    if(InpShowHighLowSwings || InpShowPDZones || InpEnableTrading) {
        UpdateTrailingExtremes();
        if(InpShowHighLowSwings) DrawHighLowSwings();
        if(InpShowPDZones)       DrawPremiumDiscountZones();
    }

    // MTF levels
    if(InpShowDaily)   DrawMTFLevels(PERIOD_D1, "D", InpDailyStyle,   InpDailyColor);
    if(InpShowWeekly)  DrawMTFLevels(PERIOD_W1, "W", InpWeeklyStyle,  InpWeeklyColor);
    if(InpShowMonthly) DrawMTFLevels(PERIOD_MN1,"M", InpMonthlyStyle, InpMonthlyColor);

    // Alerts
    DispatchAlerts();

    // v1.12: MTF strong/weak dashboard + reaction detection on the closed chart bar
    if(InpShowMTFPanel) UpdateMTF(true);

    // v1.13: liquidity-sequence tracker on the closed chart bar (alerts allowed)
    if(InpLiqEnable) UpdateLiq(true);

    // Trading
    if(InpEnableTrading) {
        RunTradingLogic();
        ManageOpenPositions();
    }

    ChartRedraw();
}
