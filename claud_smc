//===================== TRADING ======================================
double NormalizeLot(double lot) {
    double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
    double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
    double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
    if(lotStep <= 0) lotStep = 0.01;
    lot = MathFloor(lot / lotStep) * lotStep;
    lot = MathMax(minLot, MathMin(maxLot, lot));
    return NormalizeDouble(lot, 2);
}

double CalcLotForRisk(double slDistancePts) {
    if(InpFixedLots > 0) return NormalizeLot(InpFixedLots);
    if(slDistancePts <= 0) return 0;

    double balance     = AccountInfoDouble(ACCOUNT_BALANCE);
    double riskMoney   = balance * InpRiskPercent / 100.0;
    double tickValue   = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
    double tickSize    = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
    double point       = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
    if(tickSize <= 0 || tickValue <= 0 || point <= 0) return 0;

    double valuePerPoint = tickValue * (point / tickSize);
    double lossPerLot    = slDistancePts * valuePerPoint;
    if(lossPerLot <= 0) return 0;

    double lot = riskMoney / lossPerLot;
    return NormalizeLot(lot);
}

bool HasOpenPositionInDir(int dir) {
    int total = PositionsTotal();
    for(int i = 0; i < total; i++) {
        ulong tk = PositionGetTicket(i);
        if(tk == 0) continue;
        if(!g_pos.SelectByTicket(tk)) continue;
        if(g_pos.Symbol() != _Symbol) continue;
        if(g_pos.Magic()  != InpMagicNumber) continue;
        bool isBuy = g_pos.PositionType() == POSITION_TYPE_BUY;
        if(dir > 0 && isBuy)   return true;
        if(dir < 0 && !isBuy)  return true;
    }
    return false;
}

int CountOpenPositions() {
    int n = 0;
    int total = PositionsTotal();
    for(int i = 0; i < total; i++) {
        ulong tk = PositionGetTicket(i);
        if(tk == 0) continue;
        if(!g_pos.SelectByTicket(tk)) continue;
        if(g_pos.Symbol() != _Symbol) continue;
        if(g_pos.Magic()  != InpMagicNumber) continue;
        n++;
    }
    return n;
}

bool PassesPDZoneFilter(int dir) {
    if(!InpUsePDZoneFilter) return true;
    double top = g_trailing.top, bot = g_trailing.bottom;
    if(top <= bot) return true;
    double price = (SymbolInfoDouble(_Symbol, SYMBOL_BID) + SymbolInfoDouble(_Symbol, SYMBOL_ASK)) / 2.0;
    double mid   = (top + bot) / 2.0;
    if(dir > 0) return price < mid;  // long only in discount
    else        return price > mid;  // short only in premium
}

bool PassesTrendFilter(int dir, bool internalChannel) {
    if(!InpUseTrendFilter) return true;
    int bias = internalChannel ? g_internalTrend.bias : g_swingTrend.bias;
    if(dir > 0) return bias == BULLISH;
    else        return bias == BEARISH;
}

double ComputeSL(int dir) {
    double price = (dir > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)
                             : SymbolInfoDouble(_Symbol, SYMBOL_BID);
    double atrBuf = GetATR14(0);
    if(atrBuf <= 0) atrBuf = (H(0) - L(0));

    double sl = 0;
    if(InpSLMode == SL_ATR) {
        sl = (dir > 0) ? price - atrBuf * InpSLATRMultiplier
                       : price + atrBuf * InpSLATRMultiplier;
    } else if(InpSLMode == SL_LAST_PIVOT) {
        sl = (dir > 0) ? g_swingLow.currentLevel  - atrBuf * InpSLBufferATR
                       : g_swingHigh.currentLevel + atrBuf * InpSLBufferATR;
        if((dir > 0 && g_swingLow.currentLevel == 0.0) || (dir < 0 && g_swingHigh.currentLevel == 0.0)) {
            sl = (dir > 0) ? price - atrBuf * InpSLATRMultiplier
                           : price + atrBuf * InpSLATRMultiplier;
        }
    } else { // SL_TRAILING_EXTREME
        sl = (dir > 0) ? g_trailing.bottom - atrBuf * InpSLBufferATR
                       : g_trailing.top    + atrBuf * InpSLBufferATR;
        if((dir > 0 && g_trailing.bottom == DBL_MAX) || (dir < 0 && g_trailing.top == -DBL_MAX)) {
            sl = (dir > 0) ? price - atrBuf * InpSLATRMultiplier
                           : price + atrBuf * InpSLATRMultiplier;
        }
    }
    return NormalizeDouble(sl, _Digits);
}

bool CheckSpread() {
    long sp = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
    if(sp <= 0) return true;
    if(sp > InpMaxSpreadPoints) {
        PrintFormat("[SMC] Spread %d > max %d, skipping entry", (int)sp, InpMaxSpreadPoints);
        return false;
    }
    return true;
}

void TryEnter(int dir, bool internalChannel) {
    if(!InpEnableTrading) return;
    if(dir == 0)         return;
    if(!CheckSpread())   return;
    if(!PassesTrendFilter(dir, internalChannel)) return;
    if(!PassesPDZoneFilter(dir)) return;

    if(!InpAllowMultiplePos && CountOpenPositions() > 0) return;
    if(HasOpenPositionInDir(dir)) return;

    double price = (dir > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)
                             : SymbolInfoDouble(_Symbol, SYMBOL_BID);
    double sl = ComputeSL(dir);
    double slDist = MathAbs(price - sl);
    if(slDist <= 0) return;

    double slPts = slDist / SymbolInfoDouble(_Symbol, SYMBOL_POINT);
    double lot   = CalcLotForRisk(slPts);
    if(lot <= 0) {
        Print("[SMC] Lot=0, refusing trade");
        return;
    }
    double tp = (dir > 0) ? price + slDist * InpRRRatio
                          : price - slDist * InpRRRatio;
    tp = NormalizeDouble(tp, _Digits);
    sl = NormalizeDouble(sl, _Digits);

    g_trade.SetExpertMagicNumber(InpMagicNumber);
    g_trade.SetDeviationInPoints(InpSlippagePoints);

    bool ok;
    if(dir > 0) ok = g_trade.Buy (lot, _Symbol, price, sl, tp, InpTradeComment);
    else        ok = g_trade.Sell(lot, _Symbol, price, sl, tp, InpTradeComment);
    if(!ok) PrintFormat("[SMC] Order failed: %d %s", g_trade.ResultRetcode(), g_trade.ResultRetcodeDescription());
}

bool SignalFires(int dir) {
    bool bull = (dir > 0);
    switch(InpSignalSource) {
        case SIG_INTERNAL_BOS:   return bull ? g_alerts.internalBullishBOS   : g_alerts.internalBearishBOS;
        case SIG_INTERNAL_CHOCH: return bull ? g_alerts.internalBullishCHoCH : g_alerts.internalBearishCHoCH;
        case SIG_INTERNAL_ANY:   return bull ? (g_alerts.internalBullishBOS || g_alerts.internalBullishCHoCH)
                                             : (g_alerts.internalBearishBOS || g_alerts.internalBearishCHoCH);
        case SIG_SWING_BOS:      return bull ? g_alerts.swingBullishBOS      : g_alerts.swingBearishBOS;
        case SIG_SWING_CHOCH:    return bull ? g_alerts.swingBullishCHoCH    : g_alerts.swingBearishCHoCH;
        case SIG_SWING_ANY:      return bull ? (g_alerts.swingBullishBOS || g_alerts.swingBullishCHoCH)
                                             : (g_alerts.swingBearishBOS || g_alerts.swingBearishCHoCH);
        default:                 return false;
    }
}

void RunTradingLogic() {
    if(InpSignalSource == SIG_OFF) return;

    bool isInternal = (InpSignalSource == SIG_INTERNAL_BOS
                    || InpSignalSource == SIG_INTERNAL_CHOCH
                    || InpSignalSource == SIG_INTERNAL_ANY);

    if(SignalFires(+1)) TryEnter(+1, isInternal);
    if(SignalFires(-1)) TryEnter(-1, isInternal);
}

void ManageOpenPositions() {
    if(!InpTrailOnNewSwing) return;
    int total = PositionsTotal();
    for(int i = total - 1; i >= 0; i--) {
        ulong tk = PositionGetTicket(i);
        if(tk == 0) continue;
        if(!g_pos.SelectByTicket(tk)) continue;
        if(g_pos.Symbol() != _Symbol) continue;
        if(g_pos.Magic()  != InpMagicNumber) continue;

        double sl  = g_pos.StopLoss();
        double tp  = g_pos.TakeProfit();
        double op  = g_pos.PriceOpen();
        bool   buy = g_pos.PositionType() == POSITION_TYPE_BUY;
        double newSL = sl;

        double atrBuf = GetATR14(0);
        if(buy) {
            double cand = g_swingLow.currentLevel - atrBuf * InpSLBufferATR;
            if(cand > sl && cand < SymbolInfoDouble(_Symbol, SYMBOL_BID) && cand > op) newSL = cand;
        } else {
            double cand = g_swingHigh.currentLevel + atrBuf * InpSLBufferATR;
            if((cand < sl || sl == 0) && cand > SymbolInfoDouble(_Symbol, SYMBOL_ASK) && cand < op) newSL = cand;
        }
        if(newSL != sl && newSL > 0) {
            newSL = NormalizeDouble(newSL, _Digits);
            g_trade.PositionModify(tk, newSL, tp);
        }
    }
}

//===================== MTF STRONG/WEAK DASHBOARD (v1.12) ============
//
// Concept (matches DrawHighLowSwings on the chart TF, extended to MTF):
//   * In a BULLISH structure the swing LOW is the STRONG low (should hold) and
//     the swing HIGH above is the WEAK high (the liquidity target).
//   * In a BEARISH structure the swing HIGH is the STRONG high (should hold) and
//     the swing LOW below is the WEAK low (the target).
// Strategy encoded: if price touches the STRONG level and the candle CLOSES back
//   without breaking it, that is a reaction/hold — the expected destination is the
//   opposite WEAK level of the SAME timeframe (the "target", shown in gold).
//
// Per timeframe we run a compact fractal-pivot + HH/HL/LH/LL bias read over the
// last InpMTFScanBars bars. This is a self-contained recompute (not incremental)
// run on each chart new bar + on the timer, so it stays correct across restarts.

string TFName(ENUM_TIMEFRAMES tf) {
    string s = EnumToString(tf);          // e.g. "PERIOD_H4"
    if(StringFind(s, "PERIOD_") == 0) s = StringSubstr(s, 7);
    return s;
}

// Analyse one timeframe → fill swing/strong/weak/bias fields of m.
// Does NOT touch m.state / m.lastReactBar (reaction state persists across refreshes).
void AnalyzeTF(MTFLevel &m) {
    ENUM_TIMEFRAMES tf = m.tf;
    int L    = InpMTFSwingLength;
    int avail = Bars(_Symbol, tf);
    int scan = MathMin(InpMTFScanBars, avail);

    m.valid  = false;
    m.inPlay = false;
    if(scan < 2 * L + 10) return;

    double   hArr[];  datetime htArr[];  int nh = 0;
    double   lArr[];  datetime ltArr[];  int nl = 0;

    // Walk old → new. A fractal pivot at shift s needs L bars on each side.
    for(int s = scan - 1 - L; s >= 1 + L; s--) {
        int hiIdx = iHighest(_Symbol, tf, MODE_HIGH, 2 * L + 1, s - L);
        if(hiIdx == s) {
            ArrayResize(hArr, nh + 1); ArrayResize(htArr, nh + 1);
            hArr[nh]  = iHigh(_Symbol, tf, s);
            htArr[nh] = iTime(_Symbol, tf, s);
            nh++;
        }
        int loIdx = iLowest(_Symbol, tf, MODE_LOW, 2 * L + 1, s - L);
        if(loIdx == s) {
            ArrayResize(lArr, nl + 1); ArrayResize(ltArr, nl + 1);
            lArr[nl]  = iLow(_Symbol, tf, s);
            ltArr[nl] = iTime(_Symbol, tf, s);
            nl++;
        }
    }
    if(nh < 2 || nl < 2) return;

    double curH = hArr[nh - 1], prevH = hArr[nh - 2];
    double curL = lArr[nl - 1], prevL = lArr[nl - 2];

    // Bias from market structure (HH+HL = bull, LH+LL = bear; otherwise lean on
    // whichever side made the most recent decisive pivot).
    int bias;
    if(curH > prevH && curL > prevL)      bias = BULLISH;
    else if(curH < prevH && curL < prevL) bias = BEARISH;
    else if(htArr[nh - 1] > ltArr[nl - 1]) bias = (curH > prevH) ? BULLISH : BEARISH;
    else                                   bias = (curL < prevL) ? BEARISH : BULLISH;

    m.swingHigh = curH;
    m.swingLow  = curL;
    m.bias      = bias;
    m.eqMid     = (curH + curL) / 2.0;

    if(bias == BULLISH) {
        m.strongLow  = curL;   m.weakHigh = curH;   // active pair
        m.strongHigh = prevH;  m.weakLow  = prevL;  // last opposite-leg refs
        m.strongActive = m.strongLow;  m.targetWeak = m.weakHigh;
    } else { // BEARISH
        m.strongHigh = curH;   m.weakLow  = curL;   // active pair
        m.strongLow  = prevL;  m.weakHigh = prevH;  // last opposite-leg refs
        m.strongActive = m.strongHigh; m.targetWeak = m.weakLow;
    }

    double px   = SymbolInfoDouble(_Symbol, SYMBOL_BID);
    double band = (curH - curL) * 0.05;
    if(px > m.eqMid + band)      m.pricePD = +1;   // premium
    else if(px < m.eqMid - band) m.pricePD = -1;   // discount
    else                          m.pricePD = 0;   // equilibrium

    // v1.13: "in play" = price is still inside this TF's active strong↔weak band
    // (i.e. the current swing range) — the frame price is actually trading within.
    double ipLo = MathMin(m.strongActive, m.targetWeak);
    double ipHi = MathMax(m.strongActive, m.targetWeak);
    m.inPlay = (px >= ipLo && px <= ipHi);

    m.valid = true;
}

void FireMTFAlert(MTFLevel &m, bool isHold, bool isBreak) {
    if(!InpAlertsOn && !InpPushNotifyOn) return;

    string msg = "";
    if(isHold) {
        if(m.bias == BULLISH)
            msg = StringFormat("%s %s: Strong Low %s HELD (bullish rejection) -> target Weak High %s",
                               _Symbol, m.tag,
                               DoubleToString(m.strongLow, _Digits),
                               DoubleToString(m.weakHigh, _Digits));
        else
            msg = StringFormat("%s %s: Strong High %s HELD (bearish rejection) -> target Weak Low %s",
                               _Symbol, m.tag,
                               DoubleToString(m.strongHigh, _Digits),
                               DoubleToString(m.weakLow, _Digits));
    } else if(isBreak) {
        if(m.state == MTF_BROKEN_LOW)
            msg = StringFormat("%s %s: Strong Low %s BROKEN (bias shifting down)",
                               _Symbol, m.tag, DoubleToString(m.strongLow, _Digits));
        else
            msg = StringFormat("%s %s: Strong High %s BROKEN (bias shifting up)",
                               _Symbol, m.tag, DoubleToString(m.strongHigh, _Digits));
    }
    if(StringLen(msg) == 0) return;

    if(InpAlertsOn)     Alert("SMC MTF | " + msg);
    if(InpPushNotifyOn) SendNotification("SMC MTF " + msg);
}

// Evaluate the just-closed CHART bar against the active strong level of this TF.
// Rule: wick into [level ± buffer] AND close stays on the right side = HOLD (fires once).
// A close through the level = BROKEN (invalidation).
void EvaluateReaction(MTFLevel &m) {
    if(!m.valid) { m.state = MTF_NONE; return; }

    double buff = InpReactBufferATR * GetATR14(0);
    if(buff <= 0) buff = (H(0) - L(0));

    double   bh = iHigh (_Symbol, _Period, 1);
    double   bl = iLow  (_Symbol, _Period, 1);
    double   bc = iClose(_Symbol, _Period, 1);
    datetime bt = iTime (_Symbol, _Period, 1);

    if(m.bias == BULLISH && m.strongLow > 0) {
        if(bc < m.strongLow) {                              // closed below → broken
            if(m.state != MTF_BROKEN_LOW) {
                m.state = MTF_BROKEN_LOW;
                if(InpMTFBreakAlerts) FireMTFAlert(m, false, true);
            }
        } else {
            bool touched = (bl <= m.strongLow + buff);      // wick reached the zone
            if(touched && bc > m.strongLow) {               // and closed back above
                if(m.lastReactBar != bt) {
                    m.lastReactBar = bt;
                    m.state = MTF_HOLD_BULL;
                    if(InpMTFReactAlerts) FireMTFAlert(m, true, false);
                } else {
                    m.state = MTF_HOLD_BULL;
                }
            }
        }
    }
    else if(m.bias == BEARISH && m.strongHigh > 0) {
        if(bc > m.strongHigh) {                             // closed above → broken
            if(m.state != MTF_BROKEN_HIGH) {
                m.state = MTF_BROKEN_HIGH;
                if(InpMTFBreakAlerts) FireMTFAlert(m, false, true);
            }
        } else {
            bool touched = (bh >= m.strongHigh - buff);     // wick reached the zone
            if(touched && bc < m.strongHigh) {              // and closed back below
                if(m.lastReactBar != bt) {
                    m.lastReactBar = bt;
                    m.state = MTF_HOLD_BEAR;
                    if(InpMTFReactAlerts) FireMTFAlert(m, true, false);
                } else {
                    m.state = MTF_HOLD_BEAR;
                }
            }
        }
    }
    else {
        m.state = MTF_NONE;
    }
}

