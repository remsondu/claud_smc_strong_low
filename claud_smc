void DrawPremiumDiscountZones() {
    double top = g_trailing.top;
    double bot = g_trailing.bottom;
    if(top <= bot) return;

    datetime nowT   = iTime(_Symbol, _Period, 0);
    datetime leftT  = g_trailing.barTime > 0 ? g_trailing.barTime : nowT - PeriodSeconds(_Period) * 200;
    datetime rightT = nowT + PeriodSeconds(_Period) * 5;

    double premiumTop = top;
    double premiumBot = 0.95 * top + 0.05 * bot;
    double eqTop      = 0.525 * top + 0.475 * bot;
    double eqBot      = 0.525 * bot + 0.475 * top;
    double discTop    = 0.95 * bot + 0.05 * top;
    double discBot    = bot;

    color cPrem = ResolvePremium();
    color cEq   = InpEquilibriumColor;
    color cDisc = ResolveDiscount();

    DrawZone("prm", premiumTop, premiumBot, leftT, rightT, "Premium",    cPrem, ANCHOR_UPPER, premiumTop);
    DrawZone("eq",  eqTop,      eqBot,      leftT, rightT, "Equilibrium",cEq,   ANCHOR_CENTER, (eqTop + eqBot) / 2.0);
    DrawZone("dsc", discTop,    discBot,    leftT, rightT, "Discount",   cDisc, ANCHOR_LOWER, discBot);
}

