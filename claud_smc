// v1.12: one row of the MTF strong/weak dashboard
struct MTFLevel {
    ENUM_TIMEFRAMES tf;
    string          tag;          // short name e.g. "H4"
    bool            valid;
    int             bias;         // BULLISH / BEARISH / NEUTRAL
    double          swingHigh;    // current range extremes
    double          swingLow;
    double          strongHigh;   // the four named levels
    double          weakHigh;
    double          strongLow;
    double          weakLow;
    double          eqMid;
    int             pricePD;      // +1 premium, -1 discount, 0 equilibrium
    double          strongActive; // strong level in play for current bias
    double          targetWeak;   // weak opposite = expected destination on a reject
    bool            inPlay;       // v1.13: price currently sits inside this TF's strong↔weak band
    ENUM_MTF_STATE  state;        // live reaction state (persists until changed)
    datetime        lastReactBar; // debounce: last chart bar that fired a reaction alert
};

// v1.13: one tracked liquidity sequence = a single (timeframe × channel) slot.
// It always reflects the MOST RECENT structure break on that TF/channel and the
// progression of price afterward: break → leave inducement behind → push to OB →
// tap OB → original move resumes. A newer opposite break simply reseeds the slot.
struct LiqSequence {
    ENUM_TIMEFRAMES tf;
    string          tag;          // e.g. "H4"
    bool            internalCh;   // true = internal, false = swing/external
    int             dir;          // BULLISH(+1) / BEARISH(-1) of the break & intended continuation; 0 = none
    ENUM_SEQ_STATE  state;

    double          brokenPivot;  // the structural level the CHoCH/BOS broke
    datetime        breakTime;    // HTF bar time at which the break closed
    bool            isChoCH;      // true = CHoCH, false = BOS (context label)

    double          induceLevel;  // the left-behind opposite pivot (inducement liquidity)
    datetime        induceTime;
    bool            induceSwept;  // has price run the inducement since the break

    double          obTop, obBottom;  // order block zone (origin of the breaking leg)
    datetime        obTime;
    bool            obValid;

    datetime        contBarTime;  // HTF bar that produced the continuation (trigger)

    // alert debounce: last event bar time already signalled
    datetime        aBreak, aMit, aCont;
    bool            active;        // slot currently holds a live sequence
};

